{
  "name": "remis-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:prod": "ng build --configuration=production",
    "build-staging": "ng build --configuration=staging",
    "build-production": "ng build --configuration=production",
    "build-demo": "ng build --configuration=demo",
    "lint": "ng lint --fix && npm run lint:scss",
    "lint:ts": "eslint \"src/**/*.ts\" --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --fix"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^20.2.3",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^20.2.3",
    "@angular/material-date-fns-adapter": "^20.2.3",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@apollo/client": "^4.1.6",
    "@ngneat/overview": "6.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@ngxpert/hot-toast": "5.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.6",
    "@types/quill": "^2.0.14",
    "apollo-angular": "^13.0.0",
    "base64-js": "^1.5.1",
    "cytoscape": "^3.33.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "geojson": "^0.5.0",
    "graphql": "^16.13.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "leaflet-boundary-canvas": "^1.0.0",
    "leaflet-fullscreen": "^1.0.2",
    "leaflet-measure": "^3.1.0",
    "mermaid": "^11.15.0",
    "moment": "^2.30.1",
    "ngx-echarts": "^21.0.0",
    "ngx-extended-pdf-viewer": "^25.6.4",
    "ngx-image-cropper": "^9.1.6",
    "ngx-permissions": "^19.0.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-quill": "^30.0.1",
    "photoviewer": "^3.10.3",
    "proj4": "^2.20.8",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "screenfull": "^6.0.2",
    "sweetalert2": "^11.26.17",
    "swiper": "^12.0.3",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "@types/cytoscape": "^3.21.9",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.0.6",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.36.0",
    "jsdom": "^27.1.0",
    "parse5": "^8.0.0",
    "prettier": "^3.6.0",
    "stylelint": "^16.24.0",
    "stylelint-config-recess-order": "^7.3.0",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.0.8"
  }
}
